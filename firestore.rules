rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'avatarId', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.avatarId is int
        && request.resource.data.avatarId >= 0
        && request.resource.data.avatarId <= 4
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'avatarId', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.avatarId is int
        && request.resource.data.avatarId >= 0
        && request.resource.data.avatarId <= 4
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    match /games/{gameId} {
      allow read: if isAdmin() || resource.data.isPublished == true;
      allow create, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if isAdmin() || resource.data.isActive == true;
      allow create, update, delete: if isAdmin();
    }

    match /game_images/{gameId} {
      allow read: if isAdmin()
        || get(/databases/$(database)/documents/games/$(gameId)).data.isPublished == true;
      allow create, update, delete: if isAdmin();
    }

    match /downloads/{gameId} {
      allow get: if isAdmin()
        || get(/databases/$(database)/documents/games/$(gameId)).data.isPublished == true;
      allow list: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1
        && get(/databases/$(database)/documents/games/$(gameId)).data.isPublished == true;
      allow update: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1
        && get(/databases/$(database)/documents/games/$(gameId)).data.isPublished == true;
      allow delete: if isAdmin();
    }
  }
}
